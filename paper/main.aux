\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One-item host load: CXL-DRAM hit versus CXL-SSD cache miss. CXL-DRAM is Montage \texttt  {/dev/dax0.0} (\texttt  {clflush} then load). CXL-SSD is a \texttt  {vmem\_sw} window miss. T2I-10M uses the staged 800\,B vectors. LAION-10M is the first $10$M items of the 25M dump ($d{=}512$); the miss bar matches that item size on the same SSD path.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mot-cliff}{{2}{4}{One-item host load: CXL-DRAM hit versus CXL-SSD cache miss. CXL-DRAM is Montage \texttt {/dev/dax0.0} (\texttt {clflush} then load). CXL-SSD is a \texttt {vmem\_sw} window miss. T2I-10M uses the staged 800\,B vectors. LAION-10M is the first $10$M items of the 25M dump ($d{=}512$); the miss bar matches that item size on the same SSD path}{figure.caption.7}{}}
