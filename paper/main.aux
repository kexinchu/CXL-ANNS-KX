\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Two published deployments and the third point this paper serves. Flash-backed CXL memory is the \emph  {opportunity}: Flash-priced $D$, a 4\,GiB CXL-DRAM page cache, and a small host cache. FlashANNS{} is the \emph  {runtime}: a wise prefetcher plus continuous batching so scoring does not wait on NAND. Host DRAM holds search information; the two lower tiers cache and store the full-precision payload. Shared FAM is not a measured link.}}{2}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:intro-position}{{1}{2}{Two published deployments and the third point this paper serves. Flash-backed CXL memory is the \emph {opportunity}: Flash-priced $D$, a 4\,GiB CXL-DRAM page cache, and a small host cache. \sys {} is the \emph {runtime}: a wise prefetcher plus continuous batching so scoring does not wait on NAND. Host DRAM holds search information; the two lower tiers cache and store the full-precision payload. Shared FAM is not a measured link}{figure.caption.5}{}}
