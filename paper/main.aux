\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Recall--latency and recall--throughput frontiers on T2I-10M (top left), YFCC-10M (top right), and LAION-10M (bottom). Each mark summarizes five true-cold runs of 10,000 queries; error bars are 95\% bootstrap intervals. At the representative matched-recall points, FlashANNS{} sustains 595.2/3013.2/418.0 QPS, versus 254.4/1232.2/228.2 QPS for Demand (optimized layout). The original-layout Demand curve isolates the benefit of extent placement.}}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:eval-frontiers}{{8}{10}{Recall--latency and recall--throughput frontiers on T2I-10M (top left), YFCC-10M (top right), and LAION-10M (bottom). Each mark summarizes five true-cold runs of 10,000 queries; error bars are 95\% bootstrap intervals. At the representative matched-recall points, \sys {} sustains 595.2/3013.2/418.0 QPS, versus 254.4/1232.2/228.2 QPS for Demand (optimized layout). The original-layout Demand curve isolates the benefit of extent placement}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Causal evaluation of the two designs. Left: Wise Prefetcher ablation on T2I-10M at $L{=}400$ and $T{=}1$, answering when, what, and how to prefetch. Right: continuous-batching scaling for $T\in \{1,2,4,8,16\}$ on all three datasets; the vertical guide marks the primary $T{=}8$ configuration. Every mark summarizes five cold runs.}}{10}{figure.caption.26}\protected@file@percent }
\newlabel{fig:wise-ablation}{{9}{10}{Causal evaluation of the two designs. Left: Wise Prefetcher ablation on T2I-10M at $L{=}400$ and $T{=}1$, answering when, what, and how to prefetch. Right: continuous-batching scaling for $T\in \{1,2,4,8,16\}$ on all three datasets; the vertical guide marks the primary $T{=}8$ configuration. Every mark summarizes five cold runs}{figure.caption.26}{}}
\newlabel{fig:batching-ablation}{{9}{10}{Causal evaluation of the two designs. Left: Wise Prefetcher ablation on T2I-10M at $L{=}400$ and $T{=}1$, answering when, what, and how to prefetch. Right: continuous-batching scaling for $T\in \{1,2,4,8,16\}$ on all three datasets; the vertical guide marks the primary $T{=}8$ configuration. Every mark summarizes five cold runs}{figure.caption.26}{}}
