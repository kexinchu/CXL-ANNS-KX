\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Per-query dependencies limit Flash I/O concurrency.} Frozen PQ-64 end-batch on T2I-10M (nq=500, seed 42, iso-recall 0.920). $QD_{\mathrm  {eff}}(1)=0.98$, $QD_{\mathrm  {eff}}(16)=3.35$, measured $QD_{\mathrm  {sat}}=974$ (4\,KiB randread). One committed fill wave cannot hold the device; overlapping independent queries raise effective queue depth (peak 3.79 at $T=8$). How the runtime issues across queries is\nonbreakingspace \S  \ref {sec:design}.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:mot-bubbles}{{4}{5}{\textbf {Per-query dependencies limit Flash I/O concurrency.} Frozen PQ-64 end-batch on T2I-10M (nq=500, seed 42, iso-recall 0.920). $QD_{\mathrm {eff}}(1)=0.98$, $QD_{\mathrm {eff}}(16)=3.35$, measured $QD_{\mathrm {sat}}=974$ (4\,KiB randread). One committed fill wave cannot hold the device; overlapping independent queries raise effective queue depth (peak 3.79 at $T=8$). How the runtime issues across queries is~\S \ref {sec:design}}{figure.caption.9}{}}
