\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Wise Prefetcher I/O efficiency on T2I-10M at $L{=}400$. The dotted separator distinguishes the T=8 layout control (Original versus Co-use) from the T=1 prefetcher control (Serialized, Post-commit, and Extent). Window pages are host-window requests, not NAND misses; NAND bytes and commands come from physical device counters. Read amplification is physical NAND bytes divided by the useful exact-vector payload. Every mark summarizes five accepted 10,000-query runs with identical query and candidate hashes.}}{11}{figure.caption.27}\protected@file@percent }
\newlabel{fig:prefetch-io-efficiency}{{10}{11}{Wise Prefetcher I/O efficiency on T2I-10M at $L{=}400$. The dotted separator distinguishes the T=8 layout control (Original versus Co-use) from the T=1 prefetcher control (Serialized, Post-commit, and Extent). Window pages are host-window requests, not NAND misses; NAND bytes and commands come from physical device counters. Read amplification is physical NAND bytes divided by the useful exact-vector payload. Every mark summarizes five accepted 10,000-query runs with identical query and candidate hashes}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Open-loop service curves at T=8. Each panel sweeps five frozen offered rates from 0.25$\times $ to 1.25$\times $ the measured reference saturation rate and plots achieved throughput against end-to-end P99 latency, including queueing. Every mark is the median of five accepted 10,000-query runs.}}{11}{figure.caption.28}\protected@file@percent }
\newlabel{fig:load-tail-latency}{{11}{11}{Open-loop service curves at T=8. Each panel sweeps five frozen offered rates from 0.25$\times $ to 1.25$\times $ the measured reference saturation rate and plots achieved throughput against end-to-end P99 latency, including queueing. Every mark is the median of five accepted 10,000-query runs}{figure.caption.28}{}}
